<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pastel_bg"
    android:padding="20dp"
    tools:context=".MainActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/pastel_card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/title_expense_note"
                android:textColor="@color/pastel_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="@string/subtitle_expense_note"
                android:textColor="@color/pastel_subtitle"
                android:textSize="13sp" />

            <!-- Amount Label -->
            <TextView
                android:id="@+id/tvAmountLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.03"
                android:text="@string/label_enter_amount"
                android:textColor="@color/pastel_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Amount Input -->
            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pastel_input"
                android:hint="@string/hint_amount"
                android:inputType="numberDecimal"
                android:letterSpacing="0.03"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:textColor="@color/pastel_label"
                android:textColorHint="@color/pastel_hint"
                android:textSize="15sp"
                tools:ignore="Autofill" />

            <!-- Description Label -->
            <TextView
                android:id="@+id/tvDescLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="@string/label_description"
                android:textColor="@color/pastel_label"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Description Input -->
            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pastel_input"
                android:hint="@string/hint_description"
                android:inputType="text"
                android:letterSpacing="0.03"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:textColor="@color/pastel_label"
                android:textColorHint="@color/pastel_hint"
                android:textSize="15sp"
                tools:ignore="Autofill" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.04"
                    android:text="@string/btn_clear"
                    android:textAllCaps="false"
                    android:textColor="@color/pastel_btn_clear_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/pastel_btn_clear_bg"
                    app:cornerRadius="26dp"
                    app:elevation="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.04"
                    android:text="@string/btn_add"
                    android:textAllCaps="false"
                    android:textColor="@color/pastel_btn_add_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/pastel_btn_add_bg"
                    app:cornerRadius="26dp"
                    app:elevation="2dp" />
            </LinearLayout>

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginTop="20dp"
                android:background="@color/pastel_divider" />

            <!-- Cute Pastel Summary Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pastel_summary"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Recent Item Header -->
                <TextView
                    android:id="@+id/tvRecentHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.03"
                    android:text="@string/label_recent"
                    android:textColor="@color/pastel_label"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Recent Item Content -->
                <TextView
                    android:id="@+id/tvLastItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.03"
                    android:text="@string/text_no_items"
                    android:textColor="@color/pastel_subtitle"
                    android:textSize="14sp" />

                <!-- Total Amount -->
                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.03"
                    android:text="@string/text_total"
                    android:textColor="@color/pastel_summary_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>